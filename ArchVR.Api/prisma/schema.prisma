model Project {
  id             String         @id @unique @default(uuid())
  name           String         @default("Unnamed Project")
  organisationId String
  Organisation   Organisation   @relation(fields: [organisationId], references: [id])
  Scenes         Scene[]
  ProjectRoles   ProjectRoles[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProjectRoles {
  userId    String
  projectId String
  role      Int //use Role enum
  User      User    @relation(fields: [userId], references: [id])
  Project   Project @relation(fields: [projectId], references: [id])
  // Role      Role    @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, projectId])
}

model Scene {
  id        String  @id @unique @default(uuid())
  name      String  @default("Unnamed Scene")
  projectId String
  // rootId    String  @unique
  Project   Project @relation(fields: [projectId], references: [id])

  Nodes     Node[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Devices   Device[]
}

model Node {
  id        String   @id @unique @default(uuid())
  name      String   @default("Unnamed Node")
  sceneId   String
  parentId  String?
  transform String?
  fileId    String?
  Parent    Node?    @relation(name: "hierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Children  Node[]   @relation(name: "hierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  File      File?    @relation(fields: [fileId], references: [id])
  Scene     Scene    @relation(fields: [sceneId], references: [id])
}

model File {
  id                String              @id @unique @default(uuid())
  name              String
  originalFilepath  String?
  processedFilepath String?
  thumbFilepath     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Organisations     OrganisationFiles[]
  Node              Node[]
}

// an IOT device
model Device {
  id             String       @id @unique @default(uuid())
  name           String?
  username       String?      @unique
  password       String?
  deviceType     String?
  transform      String?
  parentId       String?
  Parent         Device?      @relation(name: "hierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Children       Device[]     @relation(name: "hierarchy")
  organisationId String
  Organisation   Organisation @relation(fields: [organisationId], references: [id])
  sceneId        String?
  Scene          Scene?       @relation(fields: [sceneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
