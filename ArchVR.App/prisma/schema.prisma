generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String?              @unique
  password           String?
  emailVerified      DateTime?
  image              String?
  accounts           Account[]
  sessions           Session[]
  passwordResetToken PasswordResetToken[]
  userOrganisations  UserOrganisations[]
  projectRoles       ProjectRoles[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  createdAt DateTime  @default(now())
  resetAt   DateTime?
  user      User      @relation(fields: [userId], references: [id])
  userId    String
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organisation {
  id         String              @id @unique @default(uuid())
  name       String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  customerId String?
  members    UserOrganisations[]
  projects   Project[]
  files      OrganisationFiles[]
}

model UserOrganisations {
  userId         String
  organisationId String
  role           Int //use Roq  qle enum
  user           User         @relation(fields: [userId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  // Role           Role         @relation(fields: [roleId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  defaultAt      DateTime     @default(now())

  @@id([userId, organisationId])
}

model Project {
  id             String         @id @unique @default(uuid())
  name           String         @default("Unnamed Project")
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  // Scenes         Scene[]
  projectRoles   ProjectRoles[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  scenes         Scene[]
  devices        Device[]
}

model ProjectRoles {
  userId    String
  projectId String
  role      Int //use Role enum
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
  // Role      Role    @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, projectId])
}

model Scene {
  id        String         @id @unique @default(uuid())
  name      String
  projectId String
  project   Project        @relation(fields: [projectId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  files     SceneFiles[]
  parentId  String?
  parent    Scene?         @relation(name: "hierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Scene[]        @relation(name: "hierarchy")
  devices   SceneDevices[]
  widgets   SceneWidgets[]
  graphs    SceneGraph[]
}

model File {
  id            String              @id @unique @default(uuid())
  name          String
  original      String
  processed     String?
  type          String
  thumbnail     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  organisations OrganisationFiles[]
  scenes        SceneFiles[]
}

model OrganisationFiles {
  organisationId String
  fileId         String

  file         File         @relation(fields: [fileId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@id([organisationId, fileId])
}

model SceneFiles {
  id        String   @id @unique @default(uuid())
  name      String   @default("Unnamed Node")
  sceneId   String
  parentId  String?
  transform String?
  fileId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  file      File?    @relation(fields: [fileId], references: [id])
  scene     Scene    @relation(fields: [sceneId], references: [id])
}

// device list may be populated by another service
// should be on a project, not an org
// then projects can be connected to different brokers?

model Device {
  id         String         @id @unique @default(uuid())
  name       String?
  unit       String?
  unitType   String?
  deviceType String?
  topic      String?
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  scenes     SceneDevices[]
  widgets    SceneWidgets[]
}

model SceneDevices {
  id        String   @id @unique @default(uuid())
  sceneId   String
  deviceId  String?
  transform String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model WidgetType {
  id           String         @id @unique @default(uuid())
  name         String
  component    String
  sceneWidgets SceneWidgets[]
}

model SceneWidgets {
  id           String      @id @unique @default(uuid())
  name         String      @default("New Widget")
  deviceId     String?
  device       Device?     @relation(fields: [deviceId], references: [id])
  graph        SceneGraph?
  sceneId      String
  scene        Scene       @relation(fields: [sceneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  widgetTypeId String?
  widgetType   WidgetType? @relation(fields: [widgetTypeId], references: [id])
  position     String      @default("{'x':92,'y':92,'w':128,'h':128}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SceneGraph {
  id            String        @id @unique @default(uuid())
  file          String //just storing as JSON for now
  sceneId       String
  scene         Scene         @relation(fields: [sceneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sceneWidgetId String?       @unique
  sceneWidget   SceneWidgets? @relation(fields: [sceneWidgetId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
